{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "esnext.disposable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@loop-now/plugin-sdk": ["./sdk/src/index.ts"]
    }
  },
  "include": ["sdk/src", "sdk/test", "host/src", "host/test", "official/*/platform"],
  "exclude": ["host/test/fixtures"]
}
