{
  "name": "@loop-now/plugin-hello",
  "version": "1.0.0",
  "description": {
    "zh-CN": "最小示例：平台半边在每轮结束时写一行日志，Agent 半边给 Pi 加一个 hello 工具",
    "en-US": "Minimal example: the platform half writes a log line at the end of each turn, and the Agent half gives Pi a hello tool"
  },
  "license": "Apache-2.0",
  "type": "module",
  "keywords": ["loop-now-plugin", "pi-package"],
  "peerDependencies": {
    "@loop-now/plugin-sdk": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": ["./agent/index.ts"]
  },
  "loopNow": {
    "id": "hello",
    "displayName": {
      "zh-CN": "Hello 示例",
      "en-US": "Hello example"
    },
    "platform": "./platform/index.ts",
    "events": ["run.ended"],
    "permissions": [],
    "configSchema": {
      "type": "object",
      "properties": {
        "greeting": {
          "type": "string",
          "title": "问候语",
          "description": "hello 工具回复时用的开头。",
          "default": "Hello",
          "x-scope": "project"
        }
      }
    }
  }
}
