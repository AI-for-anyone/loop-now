#!/bin/sh
# Run commands with the Node version pinned in .node-version and the npm bundled with it, without relying on the system's default node.
# The Node directory defaults to ~/.local/node-v<version>/bin and can be overridden with LOOP_NOW_WEB_NODE_BIN.
set -eu

web_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
expected="v$(tr -d '[:space:]' < "$web_dir/.node-version")"
node_bin="${LOOP_NOW_WEB_NODE_BIN:-$HOME/.local/node-$expected/bin}"

if [ ! -x "$node_bin/node" ] || [ ! -x "$node_bin/npm" ]; then
  echo "npm24: node or npm not found in ${node_bin}. Install Node ${expected}, or point LOOP_NOW_WEB_NODE_BIN at its bin directory." >&2
  exit 1
fi

actual=$("$node_bin/node" --version)
if [ "$actual" != "$expected" ]; then
  echo "npm24: ${node_bin}/node is version ${actual}, expected ${expected}." >&2
  exit 1
fi

PATH="$node_bin:$PATH"
export PATH
exec "$node_bin/npm" "$@"
