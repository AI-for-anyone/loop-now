#!/bin/sh
# 用 .node-version 规定的 Node 及其自带的 npm 执行命令，不依赖系统默认的 node。
# Node 所在目录默认为 ~/.local/node-v<版本>/bin，可用 LOOP_NOW_WEB_NODE_BIN 覆盖。
set -eu

web_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
expected="v$(tr -d '[:space:]' < "$web_dir/.node-version")"
node_bin="${LOOP_NOW_WEB_NODE_BIN:-$HOME/.local/node-$expected/bin}"

if [ ! -x "$node_bin/node" ] || [ ! -x "$node_bin/npm" ]; then
  echo "npm24: 在 ${node_bin} 中找不到 node 或 npm。请安装 Node ${expected}，或用 LOOP_NOW_WEB_NODE_BIN 指向它的 bin 目录。" >&2
  exit 1
fi

actual=$("$node_bin/node" --version)
if [ "$actual" != "$expected" ]; then
  echo "npm24: ${node_bin}/node 的版本是 ${actual}，期望 ${expected}。" >&2
  exit 1
fi

PATH="$node_bin:$PATH"
export PATH
exec "$node_bin/npm" "$@"
