# The server API URL the console talks to
VITE_LOOP_NOW_API_BASE=http://127.0.0.1:8780/api/v1
# Refresh interval of the Agent list (milliseconds)
VITE_LOOP_NOW_AGENT_LIST_POLL_MS=5000
# Backoff interval for manual reconnects after the event stream is closed for good (milliseconds)
VITE_LOOP_NOW_EVENT_RETRY_MIN_MS=1000
VITE_LOOP_NOW_EVENT_RETRY_MAX_MS=30000
# Number of files uploaded at the same time when uploading files
VITE_LOOP_NOW_UPLOAD_CONCURRENCY=4
# Refresh interval of the usage and anomaly lists in the overview (milliseconds)
VITE_LOOP_NOW_OVERVIEW_POLL_MS=30000
