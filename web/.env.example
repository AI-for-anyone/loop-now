# 控制台访问的服务端 API 地址
VITE_LOOP_NOW_API_BASE=http://127.0.0.1:8780/api/v1
# Agent 列表的刷新间隔（毫秒）
VITE_LOOP_NOW_AGENT_LIST_POLL_MS=5000
# 事件流永久断开后，手动重连的退避间隔（毫秒）
VITE_LOOP_NOW_EVENT_RETRY_MIN_MS=1000
VITE_LOOP_NOW_EVENT_RETRY_MAX_MS=30000
# 上传资料时同时上传的文件数
VITE_LOOP_NOW_UPLOAD_CONCURRENCY=4
# 概览中用量与异常列表的刷新间隔（毫秒）
VITE_LOOP_NOW_OVERVIEW_POLL_MS=30000
